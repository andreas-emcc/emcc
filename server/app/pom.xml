<?xml version="1.0" encoding="UTF-8"?>
<!-- The Spring Boot edge and launcher. The only module that may use Spring (ADR-0002). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.emcc</groupId>
    <artifactId>emc2-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>emc2-app</artifactId>
  <name>emc2 app (Spring Boot edge)</name>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.emcc</groupId>
      <artifactId>emc2-ecore</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <!-- WebSocket for the live picture (T-013); owner approved 2026-10-07. Version from Spring Boot. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <!-- Login with OpenID Connect on the server side (ADR-0022, T-036): Spring Security's OAuth2
         client, version from Spring Boot. The owner approved the download and confirmed the 19
         libraries it brings (2026-10-11): Apache-2.0, ASM BSD-3-Clause. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>emc2-app</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- As Emc2Application.main sets them in production, but short, so that the test of a hung IAM
               (OidcBackChannelTimeoutTest) takes seconds. Set at JVM start: the JDK reads them once. -->
          <systemPropertyVariables>
            <sun.net.client.defaultConnectTimeout>2000</sun.net.client.defaultConnectTimeout>
            <sun.net.client.defaultReadTimeout>2000</sun.net.client.defaultReadTimeout>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
