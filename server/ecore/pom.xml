<?xml version="1.0" encoding="UTF-8"?>
<!-- ECore: the core runtime. Plain Java, no Spring (ADR-0002). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.emcc</groupId>
    <artifactId>emc2-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>emc2-ecore</artifactId>
  <name>emc2 ECore</name>

  <dependencies>
    <!-- The model types (dev.emcc.sdk.model) and, for the plugin host, the SDK interfaces. -->
    <dependency>
      <groupId>dev.emcc</groupId>
      <artifactId>emc2-plugin-sdk</artifactId>
    </dependency>
    <!-- JSON: ECore owns the codec of the model types (docs/plugins/sdk-v0.md) and validates
         documents against model/schemas (owner decision 2026-10-05; library approved 2026-10-07). -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.emcc</groupId>
      <artifactId>emc2-plugin-sdk-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The normative JSON Schemas (PDA) ship inside ECore, so validation needs no files at runtime. -->
      <resource>
        <directory>${project.basedir}/../../model/schemas</directory>
        <targetPath>dev/emcc/ecore/json/schemas</targetPath>
        <includes>
          <include>*.schema.json</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
