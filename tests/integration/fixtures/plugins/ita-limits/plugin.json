{
  "id": "ita-limits",
  "name": "ITA limits test plugin",
  "version": "0.1.0",
  "sdkVersion": "^1.0.0",
  "kind": "utility",
  "server": { "entryClass": "dev.emcc.itatest.limits.LimitsPlugin" },
  "settings": {
    "type": "object",
    "properties": {
      "timersInStart": {
        "description": "Timers to create in start(); above the cap this disables the plugin (CR-0005).",
        "type": "integer",
        "minimum": 0,
        "default": 0
      },
      "note": {
        "description": "Free text, only to see settings changes arrive (GET /settings).",
        "type": "string",
        "default": "initial"
      }
    }
  }
}
