{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emc2:schema:security-label",
  "title": "emc2 security label",
  "description": "Confidentiality label carried by every object and layer. JSON form of a STANAG 4774 (ADatP-4774) confidentiality label; the mapping to the XML syntax is in model/README.md. Binding (STANAG 4778) is not part of the data model; it is handled behind the LabelBinder interface. Data model 1.9.0 (PDA), see model/README.md.",
  "type": "object",
  "properties": {
    "policyIdentifier": {
      "description": "The security policy the label belongs to, e.g. NATO.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uri": { "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "classification": {
      "description": "Classification defined by the policy, e.g. UNCLASSIFIED or RESTRICTED. A string, because the allowed values depend on the policy.",
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "categories": {
      "description": "Additional sensitivity categories, e.g. releasability.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tagName": { "type": "string", "minLength": 1, "maxLength": 128 },
          "type": { "enum": ["permissive", "restrictive", "informative"] },
          "uri": { "type": "string", "minLength": 1, "maxLength": 512 },
          "values": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "minItems": 1 }
        },
        "required": ["tagName", "type", "values"],
        "additionalProperties": false
      }
    },
    "creationDateTime": { "$ref": "urn:emc2:schema:common#/$defs/timestamp" },
    "reviewDateTime": { "$ref": "urn:emc2:schema:common#/$defs/timestamp" }
  },
  "required": ["policyIdentifier", "classification"],
  "additionalProperties": false
}
