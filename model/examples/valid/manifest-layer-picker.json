{
  "id": "cot",
  "name": "Cursor on Target",
  "version": "0.3.0",
  "sdkVersion": "^1.2.0",
  "kind": "general",
  "properties": [
    "ingoing",
    "outgoing"
  ],
  "settings": {
    "type": "object",
    "properties": {
      "links": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 64 },
            "direction": { "enum": ["in", "out", "both"] },
            "targetLayer": {
              "description": "Where received objects go: an existing layer, or \"New layer\" with a name.",
              "type": "object",
              "x-emc2": { "kind": "layer", "enabledWhen": { "property": "direction", "in": ["in", "both"] } },
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "name": { "type": "string", "minLength": 1, "maxLength": 256 }
              },
              "required": ["name"]
            },
            "sourceLayers": {
              "description": "The layers whose objects this link sends: existing layers only.",
              "type": "array",
              "default": [],
              "x-emc2": { "enabledWhen": { "property": "direction", "in": ["out", "both"] } },
              "items": {
                "type": "object",
                "x-emc2": { "kind": "layer", "allowNew": false },
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 256 }
                },
                "required": ["name"]
              }
            },
            "highestClassification": {
              "description": "Objects above it are not sent. Absent: the server's default label.",
              "type": "object",
              "properties": {
                "policy": { "type": "string", "minLength": 1 },
                "classification": { "type": "string", "minLength": 1, "maxLength": 64 }
              },
              "required": ["policy", "classification"]
            }
          },
          "required": ["name", "direction"]
        }
      }
    }
  },
  "server": {
    "entryClass": "dev.emcc.plugins.cot.CotPlugin"
  }
}
