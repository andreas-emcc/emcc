  "sharedDescription": "SDK 1.9.0 (CR-0048 point 2; owner PQ3 A): a shared library of a web part built against 'built' runs on a shell that shares it at 'shell' when the shell's version satisfies ^built: the same major version, and the shell's at least as new. The SDK's own entry (@emc2/plugin-sdk) is always compatible here, since its sdkVersion range decides.",
  "sharedCases": [
    { "library": "react", "built": "19.3.0", "shell": "19.3.0", "compatible": true },
    { "library": "react", "built": "19.3.0", "shell": "19.4.1", "compatible": true },
    { "library": "react", "built": "19.4.0", "shell": "19.3.0", "compatible": false },
