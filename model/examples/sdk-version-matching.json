    { "range": "^1.3.0", "sdk": "1.2.0", "compatible": false },
    { "range": "^1.3.0", "sdk": "1.4.0", "compatible": true },
    { "range": "^1.4.0", "sdk": "1.3.0", "compatible": false },
    { "range": "^1.4.0", "sdk": "1.5.0", "compatible": true },
    { "range": "^1.5.0", "sdk": "1.4.0", "compatible": false },
