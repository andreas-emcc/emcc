    { "range": "^1.0.0", "sdk": "1.4.2", "compatible": true },
    { "range": "^1.2.0", "sdk": "1.1.9", "compatible": false },
    { "range": "^1.0.0", "sdk": "2.0.0", "compatible": false },
    { "range": "^1.0.0", "sdk": "1.1.0", "compatible": true },
