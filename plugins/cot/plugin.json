  "fieldSets": [
    {
      "id": "unit",
      "label": "CoT unit",
      "fields": ["callsign", "team", "role", "staleSeconds", "how", "ce", "le"]
    }
  ],
  "server": { "entryClass": "dev.emcc.plugins.cot.CotPlugin" },
  "settings": {
    "type": "object",
    "x-emc2": {
      "groups": [
        { "id": "connections", "label": "Connections", "description": "How every TCP or TLS link treats a quiet or stalled connection, and the presence event it may send.", "properties": ["idleTimeoutSeconds", "writeStallSeconds", "sendPresence", "presenceCallsign"] },
        { "id": "advanced", "label": "Advanced", "description": "The size limit on one received CoT event.", "properties": ["maxEventBytes"], "advanced": true }
      ]
    },
    "properties": {
      "links": {
        "title": "Links",
        "description": "The connections to TAK systems, one entry per link. Without an entry the plugin does nothing. A link's name is the data source of what it receives and the key of its TLS credentials, which are local server configuration and never part of the settings. Stored 'streams' of earlier versions are no longer read: enter them again as links.",
        "type": "array",
        "default": [],
        "x-emc2": {
          "hint": "Each link talks CoT to a TAK Server or a network, one entry per link",
          "item": {
            "name": "name",
            "noun": "link",
            "state": "enabled",
            "columns": ["direction", "transport", "host", "port"],
            "id": "id"
          }
        },
        "items": {
          "type": "object",
          "x-emc2": {
            "groups": [
              { "id": "connection", "label": "Connection", "description": "Where the link connects or listens, its TLS credential, and a multicast link's interface.", "properties": ["host", "port", "tlsCredential", "address", "interface"] },
              { "id": "layers", "label": "Layers", "description": "Where received objects go, and which layers an out or both link sends from.", "properties": ["targetLayer", "sourceLayers"] },
              { "id": "classification", "label": "Classification", "description": "The security label of what the link receives, and the highest classification it sends.", "properties": ["label", "highestClassification"] },
              { "id": "sending", "label": "Sending", "description": "How long what an out or both link sends stays valid in TAK, and when unchanged objects are sent again.", "properties": ["staleSeconds", "refreshSeconds"] }
            ]
          },
          "properties": {
            "id": { "title": "Id", "description": "The link's stable id, which ECore fills in and never changes: a rename keeps it.", "type": "string", "readOnly": true },
            "name": { "title": "Name", "description": "The link's name: lowercase words separated by hyphens, at most 64 characters (e.g. tak-north). It is the data source of what the link receives. 'manual' is reserved.", "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 64, "x-emc2": { "hint": "Lowercase words with hyphens, e.g. tak-north; it names what the link receives" } },
            "transport": { "title": "Transport", "description": "tcp: a plain TCP client (a TAK Server's streaming input, 8087). tls: a TCP client with TLS and a client certificate from the server's local configuration, named like the link (8089). udp: one event per datagram, received on the address and port. multicast: a group (e.g. TAK's mesh SA, 239.2.3.1 port 6969) joined on a network interface that an administrator names.", "enum": ["tcp", "tls", "udp", "multicast"], "default": "tcp", "x-emc2": { "hint": "tcp and tls to a TAK Server, udp one event per datagram, multicast a group" } },
            "direction": { "title": "Direction", "description": "in: the link receives CoT. out: it sends the objects of its source layers. both: it does both over one connection.", "enum": ["in", "out", "both"], "default": "in", "x-emc2": { "hint": "in receives, out sends the source layers' objects, both does both" } },
            "enabled": { "title": "Enabled", "description": "Whether the plugin runs this link.", "type": "boolean", "default": true },
            "host": { "title": "Host", "description": "tcp and tls: the host of the TAK Server's CoT streaming input. udp: where an out or both link sends to.", "type": "string", "minLength": 1, "maxLength": 253, "x-emc2": { "hint": "tcp, tls: the TAK Server's host. udp out: where to send", "enabledWhen": { "property": "transport", "in": ["tcp", "tls", "udp"] } } },
            "port": { "title": "Port", "description": "tcp and tls: the TAK Server's port (8089 with TLS, 8087 without). udp and multicast: the port received on and sent to.", "type": "integer", "minimum": 1, "maximum": 65535, "x-emc2": { "hint": "tcp, tls: the TAK Server's port. udp, multicast: the port used" } },
            "tlsCredential": { "title": "TLS credential", "description": "The name of a TLS credential in the server's local configuration; empty uses the link's name.", "type": "string", "default": "", "x-emc2": { "kind": "tls-credential", "hint": "tls: the client certificate to use; empty: the one named like the link", "enabledWhen": { "property": "transport", "in": ["tls"] } } },
            "address": { "title": "Address", "description": "udp: the local address to listen on (default 127.0.0.1: only this computer; an administrator sets another address or 0.0.0.0 to receive from the network). multicast: the group to join (required).", "type": "string", "minLength": 1, "maxLength": 253, "x-emc2": { "hint": "udp: the local address to listen on. multicast: the group to join", "enabledWhen": { "property": "transport", "in": ["udp", "multicast"] } } },
            "interface": { "title": "Interface", "description": "multicast: the name of the network interface that joins the group (required: without it the link stays stopped).", "type": "string", "minLength": 1, "maxLength": 256, "x-emc2": { "hint": "multicast: the network interface that joins the group (required)", "enabledWhen": { "property": "transport", "in": ["multicast"] } } },
            "targetLayer": {
              "title": "Receive into layer",
              "description": "Where received objects go: a layer from the list, or one made with the + button, which creates it at once and picks it. Absent: a new layer named like the link, made at the first object. A layer that is deleted later is made again, by its name, at the next object; two links that name the same gone layer share the new one.",
              "type": "object",
              "x-emc2": { "hint": "Where received objects go; none: a new layer named like the link", "kind": "layer", "enabledWhen": { "property": "direction", "in": ["in", "both"] } },
              "properties": {
                "id": { "type": "string", "format": "uuid" },
                "name": { "type": "string", "minLength": 1, "maxLength": 256 }
              },
              "required": ["name"]
            },
            "sourceLayers": {
              "title": "Send from layers",
              "description": "out and both: the layers whose objects this link sends: existing layers only. Their symbols with a point are sent as CoT.",
              "type": "array",
              "default": [],
              "x-emc2": {
                "hint": "The layers whose objects are sent; their symbols with a point go out as CoT",
                "item": {
                  "name": "name",
                  "noun": "layer"
                },
                "enabledWhen": {
                  "property": "direction",
                  "in": ["out", "both"]
                }
              },
              "items": {
                "type": "object",
                "x-emc2": { "kind": "layer", "allowNew": false },
                "properties": {
                  "id": { "type": "string", "format": "uuid" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 256 }
                },
                "required": ["name"]
              }
            },
            "label": {
              "title": "Label of what is received",
              "description": "The security label of the link's layer and of the objects it creates. Default: the server's default label.",
              "type": "object",
              "x-emc2": { "hint": "The security label of the link's layer and its objects; none: the default", "enabledWhen": { "property": "direction", "in": ["in", "both"] } },
              "properties": {
                "policy": { "title": "Policy", "description": "The security policy, e.g. NATO.", "type": "string", "minLength": 1, "maxLength": 64 },
                "classification": { "title": "Classification", "description": "The classification the policy defines, e.g. UNCLASSIFIED.", "type": "string", "minLength": 1, "maxLength": 64 }
              },
              "required": ["policy", "classification"],
              "additionalProperties": false
            },
            "highestClassification": {
              "title": "Highest classification",
              "description": "out and both: objects above it are not sent. Absent: the classification of the server's default label.",
              "type": "object",
              "x-emc2": { "hint": "Objects above it are not sent; none: the server's default label", "enabledWhen": { "property": "direction", "in": ["out", "both"] } },
              "properties": {
                "policy": { "title": "Policy", "description": "The security policy, e.g. NATO.", "type": "string", "minLength": 1 },
                "classification": { "title": "Classification", "description": "The classification the policy defines, e.g. UNCLASSIFIED.", "type": "string", "minLength": 1, "maxLength": 64 }
              },
              "required": ["policy", "classification"]
            },
            "staleSeconds": { "title": "Stale time", "description": "out and both: how long what is sent stays valid in TAK when the object has no expiry in the future and no stale time of its own.", "type": "integer", "minimum": 1, "maximum": 86400, "default": 60, "x-emc2": { "hint": "How long what is sent stays valid in TAK without an expiry of its own", "unit": "s", "enabledWhen": { "property": "direction", "in": ["out", "both"] } } },
            "refreshSeconds": { "title": "Refresh", "description": "out and both: an object of a source layer that has not changed is sent again after this many seconds, so that TAK does not show it as stale. 0: only changes go out.", "type": "integer", "minimum": 0, "maximum": 86400, "default": 30, "x-emc2": { "hint": "Unchanged objects are sent again after this long; 0: only changes", "unit": "s", "enabledWhen": { "property": "direction", "in": ["out", "both"] } } }
          },
          "required": ["name", "direction"],
          "additionalProperties": false
        }
      },
      "idleTimeoutSeconds": {
        "title": "Idle timeout",
        "description": "A TCP or TLS link that receives nothing for this long is closed and connected again.",
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 300,
        "x-emc2": { "hint": "A TCP or TLS link silent this long is closed and connected again", "unit": "s" }
      },
      "writeStallSeconds": {
        "title": "Write stall",
        "description": "An out or both TCP or TLS link on which one write (one event, or the presence event) has not finished for this long (the peer stays connected but stops reading), is closed and connected again.",
        "type": "integer",
        "minimum": 5,
        "maximum": 3600,
        "default": 60,
        "x-emc2": { "hint": "A TCP or TLS link whose write is stuck this long is connected again", "unit": "s" }
      },
      "maxEventBytes": {
        "title": "Largest event",
        "description": "The largest CoT event accepted. A larger event is dropped and counted; the link continues.",
        "type": "integer",
        "minimum": 1024,
        "maximum": 1048576,
        "default": 65536,
        "x-emc2": { "hint": "The largest CoT event accepted; a larger one is dropped and counted", "unit": "bytes" }
      },
      "sendPresence": {
        "title": "Send presence",
        "description": "Send one presence event (a t-x-c-t ping) on each TCP or TLS connection, for TAK Servers that send a client nothing until it has sent one event. It sends nothing else.",
        "type": "boolean",
        "default": true,
        "x-emc2": { "hint": "One presence event per TCP or TLS connection, for TAK Servers that need it" }
      },
      "presenceCallsign": {
        "title": "Presence callsign",
        "description": "The callsign in the presence event.",
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "default": "emcc",
        "x-emc2": { "width": "short" }
      }
    }
  }
