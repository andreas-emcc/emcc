{
  "id": "cot",
  "name": "Cursor on Target",
  "version": "0.5.0",
  "sdkVersion": "^1.9.0",
  "kind": "general",
  "category": "data-links",
  "icon": "Radio",
  "properties": ["ingoing", "outgoing"],
  "connections": [
    {
      "kinds": ["tcp-client", "udp", "multicast"],
      "direction": "both",
      "settings": "/links",
      "reason": "CoT to and from TAK Servers (a TCP or TLS client) and the local network (UDP and multicast), as each link in the settings names it. The hosts, ports and groups come only from the links."
    }
  ],
  "dataTypes": [
    {
      "id": "cot.cot",
      "name": "CoT",
      "description": "Objects received as Cursor on Target events from TAK systems.",
      "defaults": { "fadeWhenExpired": true, "removeAfterExpirySeconds": 600 },
      "fieldSets": ["unit"]
    }
  ],
  "fields": [
    {
      "name": "team",
      "type": "choice",
      "label": "Team",
      "description": "The team colour of a TAK unit (CoT __group name).",
      "choices": [
        { "value": "White", "label": "White" },
        { "value": "Yellow", "label": "Yellow" },
        { "value": "Orange", "label": "Orange" },
        { "value": "Magenta", "label": "Magenta" },
        { "value": "Red", "label": "Red" },
        { "value": "Maroon", "label": "Maroon" },
        { "value": "Purple", "label": "Purple" },
        { "value": "Dark Blue", "label": "Dark Blue" },
        { "value": "Blue", "label": "Blue" },
        { "value": "Cyan", "label": "Cyan" },
        { "value": "Teal", "label": "Teal" },
        { "value": "Green", "label": "Green" },
        { "value": "Dark Green", "label": "Dark Green" },
        { "value": "Brown", "label": "Brown" }
      ],
      "editableByOthers": true
    },
    {
      "name": "role",
      "type": "choice",
      "label": "Role",
      "description": "The role of a TAK unit in its team (CoT __group role).",
      "choices": [
        { "value": "Team Member", "label": "Team Member" },
        { "value": "Team Lead", "label": "Team Lead" },
        { "value": "HQ", "label": "HQ" },
        { "value": "Sniper", "label": "Sniper" },
        { "value": "Medic", "label": "Medic" },
        { "value": "Forward Observer", "label": "Forward Observer" },
        { "value": "RTO", "label": "RTO" },
        { "value": "K9", "label": "K9" }
      ],
      "editableByOthers": true
    },
    {
      "name": "staleSeconds",
      "type": "integer",
      "label": "Stale time",
      "description": "How long this object stays valid in TAK when it is sent, if it has no expiry in the future (CoT stale time).",
      "unit": "s",
      "minimum": 1,
      "maximum": 86400,
      "editableByOthers": true
    },
    {
      "name": "callsign",
      "type": "text",
      "label": "Callsign",
      "description": "The callsign TAK shows for this object (CoT contact callsign), separate from its Name. Sent as the callsign when set; otherwise the Name is.",
      "maxLength": 64,
      "editableByOthers": true
    },
    {
      "name": "how",
      "type": "text",
      "label": "How",
      "description": "How the position was found (CoT how), e.g. h-e (human, estimated) or m-g (machine, GPS). Sent as it is; h-e when empty.",
      "maxLength": 16,
      "editableByOthers": true
    },
    {
      "name": "ce",
      "type": "number",
      "label": "Circular error",
      "description": "The circular error of the position (CoT ce). 9999999 means unknown, which is also what is sent when empty.",
      "unit": "m",
      "minimum": 0,
      "maximum": 9999999,
      "editableByOthers": true
    },
    {
      "name": "le",
      "type": "number",
      "label": "Linear error",
      "description": "The linear error of the altitude (CoT le). 9999999 means unknown, which is also what is sent when empty.",
      "unit": "m",
      "minimum": 0,
      "maximum": 9999999,
      "editableByOthers": true
    }
  ],
