{
  "id": "basemap-naturalearth",
  "name": "Natural Earth background",
  "version": "0.1.0",
  "sdkVersion": "^1.8.0",
  "kind": "background-map",
  "category": "geometoc",
  "icon": "Globe",
  "provides": ["emc2.background-map"],
  "web": { "entry": "index.js" },
