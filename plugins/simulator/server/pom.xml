<?xml version="1.0" encoding="UTF-8"?>
<!--
  Server part of the simulator (owned by PCA-simulator): the simulation engine (ADR-0040).
  Registered with one line in server/pom.xml. It uses only the SDK; geodesics come from the
  SDK's dev.emcc.sdk.geo, so it bundles no library.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.emcc</groupId>
    <artifactId>emc2-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../server/pom.xml</relativePath>
  </parent>

  <artifactId>emc2-plugin-simulator</artifactId>
  <name>emc2 plugin: simulator</name>

  <dependencies>
    <!-- ECore supplies the SDK at runtime; the jar holds only the plugin's own classes. -->
    <dependency>
      <groupId>dev.emcc</groupId>
      <artifactId>emc2-plugin-sdk</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>dev.emcc</groupId>
      <artifactId>emc2-plugin-sdk-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- InstalledPluginIT checks the packaged jar, so it runs after package (mvn verify), not in mvn test. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>packaged-plugin</id>
            <phase>integration-test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <systemPropertyVariables>
                <emc2.plugin.jar>${project.build.directory}/${project.build.finalName}.jar</emc2.plugin.jar>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
