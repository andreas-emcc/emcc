<?xml version="1.0" encoding="UTF-8"?>
<!--
  Written by hand by PCA-nvg (brief, section 7): every element of the brief's section 3, around
  Karlskrona and Goteborg, so that latitude differs from longitude everywhere. Not from any
  specification example (the specification is not public).
-->
