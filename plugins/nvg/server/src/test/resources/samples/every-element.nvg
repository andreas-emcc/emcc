              <slab:ConfidentialityInformation>
                <slab:PolicyIdentifier>NATO</slab:PolicyIdentifier>
                <slab:Classification>RESTRICTED</slab:Classification>
              </slab:ConfidentialityInformation>
              <slab:CreationDateTime>2026-11-12T08:00:00Z</slab:CreationDateTime>
            </slab:originatorConfidentialityLabel>
          </mb:Metadata>
          <mb:DataReference URI=""/>
        </mb:MetadataBinding>
      </mb:MetadataBindingContainer>
    </mb:BindingInformation>
  </metadata>
  <g uri="urn:sample:g:a" label="A">
    <g uri="urn:sample:g:b" label="B">
      <point uri="urn:sample:point" label="Rifle company" symbol="app6b:SFGPUCI----D---" x="15.2" y="58.4" speed="36" course="45" z="12.5" href="https://example.invalid/unit/1" style="stroke:#112233;font-weight:bold">
        <metadata>
          <mb:BindingInformation xmlns:mb="urn:nato:stanag:4778:bindinginformation:1:0">
            <mb:MetadataBindingContainer>
              <mb:MetadataBinding>
                <mb:Metadata>
                  <slab:originatorConfidentialityLabel xmlns:slab="urn:nato:stanag:4774:confidentialitymetadatalabel:1:0">
                    <slab:ConfidentialityInformation>
                      <slab:PolicyIdentifier>NATO</slab:PolicyIdentifier>
                      <slab:Classification>UNCLASSIFIED</slab:Classification>
                      <slab:Category TagName="Releasable to" Type="PERMISSIVE">
                        <slab:GenericValue>SWE</slab:GenericValue>
                        <slab:GenericValue>NATO</slab:GenericValue>
                      </slab:Category>
                    </slab:ConfidentialityInformation>
                    <slab:CreationDateTime>2026-11-12T08:00:00Z</slab:CreationDateTime>
                  </slab:originatorConfidentialityLabel>
                </mb:Metadata>
                <mb:DataReference URI="urn:sample:point"/>
              </mb:MetadataBinding>
            </mb:MetadataBindingContainer>
          </mb:BindingInformation>
        </metadata>
        <ExtendedData schemaRef="#urn:sample:schema">
          <SimpleData key="strength">120</SimpleData>
        </ExtendedData>
        <textInfo>Second company, dug in.</textInfo>
        <TimeStamp>2026-11-12T07:30:00Z</TimeStamp>
        <TimeSpan>
          <begin>2026-11-12T06:00:00Z</begin>
          <end>2026-11-13T06:00:00Z</end>
        </TimeSpan>
      </point>
    </g>
  </g>
  <point uri="urn:sample:point:d" symbol="app6d:10031000001211000000" x="15.5869" y="56.1612"/>
